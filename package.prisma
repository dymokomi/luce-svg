#prisma 4.0
def package "luce-svg" {
    str owner = "dymokomi"
    str version = "0.4.5"
    str kind = "package"
    str language = "luce-base"
    str description = "A small SVG parser, flattener and rasteriser (coverage masks and linear RGBA) for Luce/Base."
    str readme = "README.md"

    def export "svg" {
        str module = "luce_svg.svg"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
