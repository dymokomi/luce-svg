## The value of a hex digit, or none.
func hex_digit(byte: u8) -> u32?:
    if is_digit(byte):
        return (u32)(byte - '0')
    if byte >= 'a' and byte <= 'f':
        return (u32)(byte - 'a') + 10
    if byte >= 'A' and byte <= 'F':
        return (u32)(byte - 'A') + 10
    return none
