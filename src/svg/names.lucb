## The tag named `name`, or none for an element the tree does not keep.
func tag_named(name: str) -> Tag?:
    let index = find_name(tag_names, name) else return none
    return (Tag)(u8)index

## The attribute named `name` (`xlink:href` is `href`), or none.
func attr_named(name: str) -> Attr?:
    let index = find_name(attr_names, name) else return none
    return (Attr)(u16)index

## The name of `tag` as SVG spells it.
pub func tag_name_of(tag: Tag) -> str:
    return tag_names[(usize)(u8)tag]

## The name of `attr` as SVG spells it.
pub func attr_name_of(attr: Attr) -> str:
    return attr_names[(usize)(u16)attr]

func is_presentation(attr: Attr) -> bool:
    return (attr_flags[(usize)(u16)attr] & 1) != 0

func is_inherited(attr: Attr) -> bool:
    return (attr_flags[(usize)(u16)attr] & 2) != 0

func accepts_inherit(attr: Attr) -> bool:
    return (attr_flags[(usize)(u16)attr] & 4) != 0

## Binary search of the sorted `names` for `name`.
func find_name(names: const str[], name: str) -> usize?:
    var low: usize = 0
    var high = names.length
    while low < high:
        let middle = (low + high) // 2
        let order = compare_text(names[middle], name)
        if order == 0:
            return middle
        if order < 0:
            low = middle + 1
        else:
            high = middle
    return none

## Byte order of `a` against `b`: negative, zero or positive.
func compare_text(a: str, b: str) -> i64:
    let count = a.length if a.length < b.length else b.length
    for index in 0..<count:
        let x = a.bytes[index]
        let y = b.bytes[index]
        if x != y:
            return (i64)x - (i64)y
    return (i64)a.length - (i64)b.length
