#==============================================================================================
#
#   svg/coverage - The exact-area coverage rasteriser and the 8-bit mask
#
#   DESCRIPTION:
#       Scan conversion shared by both rasterisers: edges accumulate signed area into a
#       row-major buffer (one spare cell per row), and a prefix sum along each row turns it
#       into per-pixel coverage, which is exact for polygons. Fills trace an element's
#       outlines as they are; strokes trace a rectangle per segment plus discs for round
#       caps and joins, and dashes cut the outline first. `rasterize` resolves each contour
#       into an 8-bit mask, the higher value winning where shapes overlap.
#
#==============================================================================================

## Where the drawing lands in a `width` by `height` pixel bitmap: scaled to fit
## uniformly and centred, as an icon is fitted to its slot.
struct Placement:
    var scale: f64
    var offset_x: f64
    var offset_y: f64

func placement(drawing: const Drawing*, width: u32, height: u32) -> Placement:
    let scale = math.min((f64)width / drawing.view_w, (f64)height / drawing.view_h)
    return Placement(scale = scale, offset_x = ((f64)width - drawing.view_w * scale) * 0.5, offset_y = ((f64)height - drawing.view_h * scale) * 0.5)

## Signed-area accumulation of one edge into `acc` (width + 1 cells per row), the
## exact-area method font rasterisers use: after a prefix sum along each row,
## a cell holds the winding-weighted coverage of that pixel.
func accumulate(acc: f32[], width: usize, height: usize, x0: f64, y0: f64, x1: f64, y1: f64):
    if y0 == y1:
        return
    let stride = width + 1
    let direction: f64 = 1.0 if y1 > y0 else -1.0
    var top = y0
    var bottom = y1
    var left = x0
    var right = x1
    if direction < 0.0:
        top = y1
        bottom = y0
        left = x1
        right = x0
    let dxdy = (right - left) / (bottom - top)
    var x = left
    var row = (usize)math.max(0.0, math.floor(top))
    if top < 0.0:
        x -= top * dxdy
    let last_row = (usize)math.min((f64)height, math.ceil(bottom))
    while row < last_row:
        let row_top = math.max(top, (f64)row)
        let row_bottom = math.min(bottom, (f64)(row + 1))
        let dy = row_bottom - row_top
        let x_next = x + dxdy * dy
        let base = row * stride
        var xa = x
        var xb = x_next
        if xa > xb:
            let swap = xa
            xa = xb
            xb = swap
        let xa_floor = math.floor(xa)
        let xa_index = (i64)xa_floor
        let xb_index = (i64)math.ceil(xb)
        if xa_index < 0 or xb_index > (i64)width + 1:
            # Off the bitmap: only its winding matters for what lies to the right.
            if xa_index < 0:
                acc[base] += (f32)(direction * dy)
            else:
                x = x_next
                row += 1
                continue
        elif xa_index + 1 >= xb_index:
            # Within one column: split the area between it and the next, which for an
            # edge in the spare cell lies past the row and is dropped.
            let coverage = (xa_floor + 1.0 - (xa + xb) * 0.5)
            acc[base + (usize)xa_index] += (f32)(direction * dy * coverage)
            if (usize)xa_index < width:
                acc[base + (usize)xa_index + 1] += (f32)(direction * dy * (1.0 - coverage))
        else:
            # Across several columns: the exact-area split font rasterisers use.
            let d = direction * dy
            let s = 1.0 / (xb - xa)
            let xa_frac = xa - xa_floor
            let a0 = 0.5 * s * (1.0 - xa_frac) * (1.0 - xa_frac)
            let xb_frac = xb - (f64)xb_index + 1.0
            let am = 0.5 * s * xb_frac * xb_frac
            acc[base + (usize)xa_index] += (f32)(d * a0)
            if xb_index == xa_index + 2:
                acc[base + (usize)xa_index + 1] += (f32)(d * (1.0 - a0 - am))
            else:
                let a1 = s * (1.5 - xa_frac)
                acc[base + (usize)xa_index + 1] += (f32)(d * (a1 - a0))
                var column = xa_index + 2
                while column < xb_index - 1:
                    acc[base + (usize)column] += (f32)(d * s)
                    column += 1
                let a2 = a1 + (f64)(xb_index - xa_index - 3) * s
                acc[base + (usize)(xb_index - 1)] += (f32)(d * (1.0 - a2 - am))
            if (usize)xb_index <= width:
                acc[base + (usize)xb_index] += (f32)(d * am)
        x = x_next
        row += 1

## Accumulate a closed polygon of pixel-space points, oriented so its area counts positive.
func accumulate_polygon(acc: f32[], width: usize, height: usize, polygon: const Point[]):
    if polygon.length < 3:
        return
    var area = 0.0
    for index in 0..<polygon.length:
        let a = polygon[index]
        let b = polygon[(index + 1) % polygon.length]
        area += a.x * b.y - b.x * a.y
    for index in 0..<polygon.length:
        var a = polygon[index]
        var b = polygon[(index + 1) % polygon.length]
        if area < 0.0:
            let swap = a
            a = b
            b = swap
        accumulate(acc, width, height, a.x, a.y, b.x, b.y)

## Resolve the accumulator into `coverage` at `opacity`, taking the higher value
## where shapes overlap, then clear it for the next shape.
func resolve(acc: f32[], width: usize, height: usize, opacity: f64, coverage: u8[]):
    let stride = width + 1
    for row in 0..<height:
        var sum: f32 = 0.0
        for column in 0..<width:
            sum += acc[row * stride + column]
            acc[row * stride + column] = 0.0
            let value = math.min(1.0, math.abs((f64)sum)) * opacity
            let byte = (u8)(value * 255.0 + 0.5)
            let slot = row * width + column
            if byte > coverage[slot]:
                coverage[slot] = byte
        acc[row * stride + width] = 0.0

## A regular polygon approximating a disc, for round caps and joins.
func disc(acc: f32[], width: usize, height: usize, centre: Point, radius: f64) -> !:
    let ring = try alloc Point[16] in memory.heap
    defer free(ring) in memory.heap
    for index in 0..<(usize)16:
        let angle = (f64)index / 16.0 * math.pi * 2.0
        ring[index] = Point(centre.x + math.cos(angle) * radius, centre.y + math.sin(angle) * radius)
    accumulate_polygon(acc, width, height, ring)

## Stroke one polyline of pixel-space points: a rectangle per segment, round joins
## at the interior vertices and round caps at the ends when asked. A closed run
## repeats its first point at the end and gets joins everywhere, no caps.
func stroke_run(acc: f32[], width: usize, height: usize, path: const Point[], closed: bool, half: f64, round_cap: bool, round_join: bool) -> !:
    let scratch = try alloc Point[4] in memory.heap
    defer free(scratch) in memory.heap
    let count = path.length
    if count == 1:
        if round_cap:
            try disc(acc, width, height, path[0], half)
        return
    for index in 0..<count - 1:
        let a = path[index]
        let b = path[index + 1]
        let dx = b.x - a.x
        let dy = b.y - a.y
        let length = math.sqrt(dx * dx + dy * dy)
        if length > 1e-9:
            let nx = -dy / length * half
            let ny = dx / length * half
            scratch[0] = Point(a.x + nx, a.y + ny)
            scratch[1] = Point(b.x + nx, b.y + ny)
            scratch[2] = Point(b.x - nx, b.y - ny)
            scratch[3] = Point(a.x - nx, a.y - ny)
            accumulate_polygon(acc, width, height, scratch)
    for index in 0..<count:
        let interior = closed or (index > 0 and index + 1 < count)
        if (interior and round_join) or (not interior and round_cap):
            if not (closed and index == count - 1):
                try disc(acc, width, height, path[index], half)

## Stroke a polyline as dashes: walk its length against the pattern (in pixels),
## emitting each "on" run as its own capped stroke.
func stroke_dashed(acc: f32[], width: usize, height: usize, path: const Point[], contour: Contour, scale: f64, half: f64) -> !:
    var total = 0.0
    for index in 0..<contour.dash_count:
        total += contour.dashes[index] * scale
    if total <= 1e-9:
        return
    # Where in the pattern the path begins, from the offset.
    var phase = contour.dash_offset * scale
    phase = phase - math.floor(phase / total) * total
    var slot: usize = 0
    var remaining = contour.dashes[0] * scale
    while phase >= remaining and slot < contour.dash_count * 2:
        phase -= remaining
        slot = (slot + 1) % contour.dash_count
        remaining = contour.dashes[slot] * scale
    remaining -= phase
    var on = slot % 2 == 0
    let run = try alloc Point[path.length + 2 * contour.dash_count + 8] in memory.heap
    defer free(run) in memory.heap
    var run_count: usize = 0
    if on:
        run[0] = path[0]
        run_count = 1
    for index in 0..<path.length - 1:
        var a = path[index]
        let b = path[index + 1]
        var dx = b.x - a.x
        var dy = b.y - a.y
        var length = math.sqrt(dx * dx + dy * dy)
        while length > remaining:
            let t = remaining / length
            let cut = Point(a.x + dx * t, a.y + dy * t)
            if on:
                if run_count < run.length:
                    run[run_count] = cut
                    run_count += 1
                try stroke_run(acc, width, height, run[..<run_count], false, half, contour.round_cap, contour.round_join)
                run_count = 0
            else:
                run[0] = cut
                run_count = 1
            on = not on
            slot = (slot + 1) % contour.dash_count
            remaining = contour.dashes[slot] * scale
            a = cut
            dx = b.x - a.x
            dy = b.y - a.y
            length = math.sqrt(dx * dx + dy * dy)
        remaining -= length
        if on and run_count < run.length:
            run[run_count] = b
            run_count += 1
    if on and run_count >= 1:
        try stroke_run(acc, width, height, run[..<run_count], false, half, contour.round_cap, contour.round_join)

## The pixel-space half width a contour is stroked with, never under a quarter pixel.
func stroke_half(contour: Contour, fit: Placement) -> f64:
    return math.max(0.25, contour.width * fit.scale * 0.5)

## Accumulate a contour's outline for filling; its winding is the author's.
func trace_fill(acc: f32[], width: usize, height: usize, drawing: const Drawing*, contour: Contour, fit: Placement):
    let origin = contour.start
    let count = contour.length
    for index in 0..<count:
        let a = drawing.points[origin + index]
        let b = drawing.points[origin + (index + 1) % count]
        accumulate(acc, width, height, fit.offset_x + a.x * fit.scale, fit.offset_y + a.y * fit.scale, fit.offset_x + b.x * fit.scale, fit.offset_y + b.y * fit.scale)

## Accumulate a contour's stroke: solid or dashed, with its caps and joins.
func trace_stroke(acc: f32[], width: usize, height: usize, drawing: const Drawing*, contour: Contour, fit: Placement) -> !:
    let origin = contour.start
    let count = contour.length
    let half = stroke_half(contour, fit)
    # The contour in pixel space, closed ones with their first point repeated.
    let extra: usize = 1 if contour.closed and count > 1 else 0
    let path = try alloc Point[count + extra] in memory.heap
    defer free(path) in memory.heap
    for index in 0..<count + extra:
        let p = drawing.points[origin + index % count]
        path[index] = Point(fit.offset_x + p.x * fit.scale, fit.offset_y + p.y * fit.scale)
    if contour.dash_count == 0:
        try stroke_run(acc, width, height, path, contour.closed and count > 2, half, contour.round_cap, contour.round_join)
    else:
        try stroke_dashed(acc, width, height, path, contour, fit.scale, half)

## Check a bitmap's size and allocate a cleared accumulator for it.
func accumulator(width: u32, height: u32) -> f32[]!:
    if width == 0 or height == 0 or width > 4096 or height > 4096:
        error(invalid, "a bitmap is 1..4096 pixels on a side")
    let acc = try alloc f32[((usize)width + 1) * (usize)height] in memory.heap
    for index in 0..<acc.length:
        acc[index] = 0.0
    return acc

## Rasterise `drawing` into `coverage`, `width * height` bytes, top-down: 255 where
## a fill or stroke covers a pixel fully, less along edges and under partial opacity.
## Strokes get their width, round caps and round joins; fills use the nonzero rule.
## Colors are ignored: this is the mask a caller tints, as luce-ui does for icons.
pub func rasterize(drawing: const Drawing*, width: u32, height: u32, coverage: u8[]) -> !:
    let acc = try accumulator(width, height)
    defer free(acc) in memory.heap
    if coverage.length != (usize)width * (usize)height:
        error(invalid, "the coverage buffer must hold width * height bytes")
    for index in 0..<coverage.length:
        coverage[index] = 0
    let w = (usize)width
    let h = (usize)height
    let fit = placement(drawing, width, height)
    for contour_index in 0..<drawing.contour_used:
        let contour = drawing.contours[contour_index]
        if contour.length < 1:
            continue
        if contour.fill.painted and contour.length >= 3:
            trace_fill(acc, w, h, drawing, contour, fit)
            resolve(acc, w, h, contour.fill_opacity, coverage)
        if contour.stroke.painted:
            try trace_stroke(acc, w, h, drawing, contour, fit)
            resolve(acc, w, h, contour.stroke_opacity, coverage)
